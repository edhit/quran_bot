{
  "name": "quran-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Личный учитель Корана в Telegram: заучивание, повторение по SRS, проверка чтения голосом через Claude",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:create": "node scripts/d1.mjs create",
    "db:id": "node scripts/d1.mjs info",
    "db:migrate": "node scripts/d1.mjs execute --remote --file=./migrations/0001_init.sql",
    "db:migrate:local": "node scripts/d1.mjs execute --local --file=./migrations/0001_init.sql",
    "quran:fetch": "node scripts/seed-quran.mjs",
    "quran:load": "node scripts/d1.mjs execute --remote --file=./seed/quran.sql",
    "quran:load:local": "node scripts/d1.mjs execute --local --file=./seed/quran.sql",
    "hook:set": "node scripts/set-webhook.mjs",
    "hook:info": "node scripts/set-webhook.mjs --info"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.131.1"
  }
}
