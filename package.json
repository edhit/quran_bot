{
  "name": "quran-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Личный учитель Корана в Telegram: заучивание, повторение по SRS, проверка чтения голосом через Claude",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:create": "wrangler d1 create quran-bot",
    "db:id": "wrangler d1 info quran-bot",
    "db:migrate": "wrangler d1 execute quran-bot --remote --file=./migrations/0001_init.sql",
    "db:migrate:local": "wrangler d1 execute quran-bot --local --file=./migrations/0001_init.sql",
    "quran:fetch": "node scripts/seed-quran.mjs",
    "quran:load": "wrangler d1 execute quran-bot --remote --file=./seed/quran.sql",
    "quran:load:local": "wrangler d1 execute quran-bot --local --file=./seed/quran.sql",
    "hook:set": "node scripts/set-webhook.mjs",
    "hook:info": "node scripts/set-webhook.mjs --info"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.131.1"
  }
}
